// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Asset {
  BTC
  SOL
  ETH
}

enum Side {
  buy
  sell
}

enum Type {
  limit
  market
}

enum Status {
  Open
  Filled
  Cancelled
  Partially_filled
}

model Balances {
  userId       Int      @id   @unique
  SOL_avail    Int
  SOL_lock     Int
  ETH_avail    Int
  ETH_lock     Int
  USD_avail    Int
  USD_lock     Int
  BTC_avail    Int
  BTC_lock     Int
  Orders      Orders[]
}

model Orders {
  orderId     String     @id  
  userId       Int
  user       Balances    @relation(fields: [userId], references: [userId])
  market      Asset
  price        Int
  quantity     Int
  type         Type
  side         Side
  filledQty     Int
  status       Status
  createdAt   DateTime
  BuyFills     Fills[]   @relation("buy")
  SellFills    Fills[]   @relation("sell")
}

model Fills {
  fillId      String    @id  
  quantity     Int
  side         Side 
  userId        Int 
  price         Int 
  asset        Asset 
  buyOrderId   String     
  buyOrder     Orders    @relation("buy", fields: [buyOrderId], references: [orderId])
  sellOrderId  String
  sellOrder    Orders    @relation("sell", fields: [sellOrderId], references: [orderId])
  createdAt    DateTime 
}
